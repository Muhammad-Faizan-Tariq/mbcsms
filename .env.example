# Copy to .env and fill in. Used by docker compose.
DB_NAME=mbc_sms
DB_USER=mbc_user
DB_PASS=change_me
DB_ROOT_PASS=change_me_too
# Local: http://localhost   VPS: http://YOUR_SERVER_IP (or https://your-domain)
APP_URL=http://localhost
# Must match the salt used in database/schema.sql seed users unless you reset passwords
SALT=mbc_sms_secure_salt_2024
# Host port for the web container (use 8080 if 80 is busy)
HTTP_PORT=80
