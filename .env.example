# Copy to .env and fill in. Used by docker compose.
DB_NAME=mbc_sms
DB_USER=mbc_user
DB_PASS=change_me
DB_ROOT_PASS=change_me_too
# VPS public address
APP_URL=http://179.197.249.22
# Must match the salt used in database/schema.sql seed users unless you reset passwords
SALT=mbc_sms_secure_salt_2024
# Host port for the web container (use 8080 if 80 is busy)
HTTP_PORT=80

# ---- SMPP (Jasmin) ----
# Public IP / domain suppliers use to reach your SMPP server
SMPP_PUBLIC_HOST=179.197.249.22
SMPP_PORT=2775
# Credentials you give to the supplier
SMPP_SUPPLIER_USER=mbc_supplier
# max 8 characters (SMPP protocol limit)
SMPP_SUPPLIER_PASS=chgme123
# Secret used by the gateway when it calls the panel (long random string)
SMPP_WEBHOOK_KEY=change_me_long_random_string
# Optional: if the supplier gives YOU their SMPP server, fill these to bind out to it
SUPPLIER_CLIENT_HOST=
SUPPLIER_CLIENT_PORT=2775
SUPPLIER_CLIENT_USER=
SUPPLIER_CLIENT_PASS=

# Max numbers one user can self-allocate per range (extra space is given by the manager)
SELF_ALLOC_LIMIT_CLIENT=100
SELF_ALLOC_LIMIT_AGENT=2000
